# Cliderness - every runtime data path must be a valid DOS 8.3 name
#   cmake -DROOT=<repo> -P tools/check_dos_names.cmake
# (CMake regular expressions have no {m,n}, so lengths are checked manually)
file(GLOB_RECURSE files RELATIVE "${ROOT}" "${ROOT}/data/*")
set(bad "")
foreach(f ${files})
  string(REPLACE "/" ";" parts "${f}")
  set(ok TRUE)
  foreach(p ${parts})
    string(FIND "${p}" "." dot)
    if(dot EQUAL -1)
      set(base "${p}")
      set(ext "")
    else()
      string(SUBSTRING "${p}" 0 ${dot} base)
      math(EXPR start "${dot} + 1")
      string(SUBSTRING "${p}" ${start} -1 ext)
    endif()
    string(LENGTH "${base}" lb)
    string(LENGTH "${ext}" le)
    if(lb LESS 1 OR lb GREATER 8 OR le GREATER 3 OR NOT base MATCHES "^[A-Za-z0-9_-]+$"
       OR (le GREATER 0 AND NOT ext MATCHES "^[A-Za-z0-9_-]+$"))
      set(ok FALSE)
    endif()
  endforeach()
  if(NOT ok)
    list(APPEND bad "${f}")
  endif()
endforeach()
list(LENGTH files n)
if(n EQUAL 0)
  message(FATAL_ERROR "no data files found under ${ROOT}/data")
endif()
if(bad)
  message(FATAL_ERROR "not DOS 8.3 safe: ${bad}")
endif()
message(STATUS "all ${n} data files are DOS 8.3 safe")
