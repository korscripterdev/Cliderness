# Cliderness biomes - land (kind=land). The first matching entry wins.
# height = surface y range, temp/humid/special = climate samples 0..100.
# tree / plant densities are per 1000 surface cells.

[biome volcanic]
name=Volcanic Land
kind=land
height=66..255
special=93..100
surface=ash
subsurface=basalt
stone=basalt
plant=dead_bush
plant2=magma_rock
plant_density=25
base_temp=34
humidity=10
map_color=lightred

[biome alpine]
name=Alpine Highlands
kind=land
height=96..255
surface=gravel
subsurface=stone
plant=fern
plant_density=20
tree=pine_log
tree_top=pine_needles
tree_density=6
base_temp=2
humidity=40
map_color=lightgray

[biome snowfield]
name=Snowfield
kind=land
temp=0..14
surface=snow
subsurface=dirt
freeze=1
plant=dead_bush
plant_density=3
base_temp=-14
humidity=40
map_color=white

