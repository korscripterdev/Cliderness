# Cliderness weather definitions
# temp / humid = climate ranges (0..100) where this weather can start.
# visibility % of normal, temp_delta in deg C, move_penalty % slower,
# stamina = extra stamina drain per game minute, duration in game minutes.
# ancient: 0 = overworld only, 1 = Ancient Dimension only, 2 = both.
# The first entry is the default (clear).

[weather clear]
name=Clear
weight=40
cloud=5
wind=10
duration=120..480
ancient=2

[weather cloudy]
name=Cloudy
weight=22
cloud=75
wind=20
visibility=90
temp_delta=-1
duration=90..300
ancient=2

[weather drizzle]
name=Drizzle
precip=rain
intensity=8
weight=10
cloud=80
wind=15
visibility=85
temp_delta=-2
temp=20..100
humid=30..100
duration=30..120

[weather rain]
name=Rain
precip=rain
intensity=20
weight=10
cloud=90
wind=30
visibility=70
temp_delta=-3
move_penalty=5
temp=20..100
humid=40..100
duration=40..180

