# Cliderness block definitions - terrain, rock, liquids
# glyph / floor_glyph: CP437 code (decimal) or a single character.
# glyph is drawn when the block is at the player's eye level (a wall),
# floor_glyph when the player looks down onto its top face.
# hardness = base break time in ticks (20 ticks = 1 second).

[block bedrock]
name=Bedrock
category=rock
glyph=219
fg=darkgray
floor_glyph=178
floor_fg=darkgray
flags=solid,nomine
hardness=255
drop=none

