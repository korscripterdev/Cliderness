# Cliderness block definitions - wood, leaves and vegetation
# Trees occupy the cell above the ground (eye level) so they block movement.

[block oak_log]
name=Oak Tree
category=wood
glyph=6
fg=green
floor_glyph='o'
floor_fg=brown
flags=solid
hardness=30
tool=axe
weight=800
density=700

