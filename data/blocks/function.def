# Cliderness block definitions - stations, storage, beds, farming
# func: station / chest / bed / farmland / crop / portal
# Crops and saplings: grow_to = next stage, grow_minutes = game minutes per
# stage, grow_top = block placed above when a sapling becomes a tree.

[block workbench]
name=Workbench
category=functional
glyph=227
fg=brown
floor_glyph=227
floor_fg=brown
flags=solid
station=workbench
hardness=25
tool=axe
fuel=3

