# Cliderness block definitions - ores and minerals
# ore_y = min-max height, ore_chance = per 10000 host blocks, ore_host = block id

[block coal_ore]
name=Coal Ore
category=ore
glyph=4
fg=black
bg=lightgray
floor_glyph=4
floor_fg=black
floor_bg=lightgray
flags=solid
hardness=35
tool=pickaxe
drop=coal
ore_y=5-110
ore_chance=120
ore_host=stone

