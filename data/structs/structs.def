# Cliderness structures and loot tables
# [structure <id>]  type = mine / ruins / city, rarity = percent of regions
# (mines: 128 x 128 regions, others: 192 x 192), y = corridor heights (mines),
# length = half length of the corridors (mines) or radius (ruins, city).
# [loot <id>]  <item> = min-max:chance%  (rolled once when a crate is opened)

[structure abandoned_mine]
name=Abandoned Mine
type=mine
rarity=45
y=16-44
length=36
support=oak_planks
light=torch
crate=mine_crate

[structure stone_ruins]
name=Stone Ruins
type=ruins
rarity=22
length=3
wall=cobblestone
crate=ruins_crate

[loot mine]
coal=2-8:85
raw_iron=1-4:60
raw_copper=1-4:45
iron_ingot=1-3:30
torch=2-6:70
bread=1-2:40
iron_pickaxe=1-1:6
stone_pickaxe=1-1:25
rope=1-3:35
bucket=1-1:12

[loot ruins]
cloth=1-4:60
bandage=1-3:45
wheat_seeds=2-6:50
potato=1-3:40
stone_axe=1-1:20
fiber_bag=1-1:10
gold_ingot=1-2:12
gem=1-1:6

[structure ancient_city]
name=Ancient City
type=city
dimension=ancient
rarity=30
length=22
wall=ancient_bricks
support=ancient_stone
crate=ancient_crate

[structure ancient_shrine]
name=Ancient Shrine
type=ruins
dimension=ancient
rarity=40
length=3
wall=ancient_bricks
crate=ancient_crate

[loot ancient]
aether_shard=2-6:90
raw_starmetal=1-3:50
starmetal_ingot=1-2:25
ancient_relic=1-2:45
star_petal=2-5:50
portal_core=1-1:15
gem=1-2:30
crystal_shard=2-4:40
