# Cliderness item definitions - resources and materials
# Every block with item=1 (default) automatically gets a block item with the
# same id; this file only defines items that are not blocks.
# weight in grams, volume in centilitres, density in kg/m3 (< 1000 floats).

[item stick]
name=Stick
type=material
glyph='/'
fg=brown
weight=50
volume=10
density=600
fuel=1

[item plant_fiber]
name=Plant Fiber
type=material
glyph='"'
fg=green
weight=10
volume=5
density=500
fuel=1

