# Cliderness item definitions - tools
# power = mining speed in percent (100 = bare hands); durability = uses.
# Tools are not craftable yet in 0.1.0 (crafting is Phase 4): use /give.

[item wooden_pickaxe]
name=Wooden Pickaxe
type=tool
tool=pickaxe
glyph=231
fg=brown
power=200
durability=60
stack=1
weight=900
volume=60
density=700

