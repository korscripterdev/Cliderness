# Cliderness item definitions - wearable equipment and bags
# equip = head / body / legs / feet / back
# defense = damage reduction percent, insulation = deg C of warmth,
# capacity = extra carry capacity in kg

[item fiber_hat]
name=Fiber Hat
type=armor
equip=head
glyph=94
fg=yellow
insulation=2
defense=1
durability=80
stack=1
weight=100
volume=20
density=500
repair=cloth
repair_pct=40

