# Cliderness - DJGPP build (32-bit protected-mode DOS; needs CWSDPMI.EXE)
# Created by korscripterdev
#   make -f builds/dos/Makefile.dj   (cross: CC=i586-pc-msdosdjgpp-gcc)
CC     ?= i586-pc-msdosdjgpp-gcc
CFLAGS ?= -std=gnu89 -O2 -Wall -Isrc
SRCS   := $(shell grep -v '^\#' builds/dos/sources.lst)
OBJS   := $(patsubst src/%.c,builds/dos/objdj/%.o,$(SRCS))
EXE    := builds/dos/CLIDEDJ.EXE

$(EXE): $(OBJS)
	$(CC) -o $@ $(OBJS)

builds/dos/objdj/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf builds/dos/objdj $(EXE)

.PHONY: clean
